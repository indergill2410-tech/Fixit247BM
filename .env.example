# ============================================================
# Fixit247BM — Environment Variables
# Copy to .env.local (local dev) or set in Render dashboard
# Variables marked [REQUIRED] will crash the app if missing
# Variables marked [OPTIONAL] degrade non-critical features
# ============================================================

# ── App ─────────────────────────────────────────────────────
# [REQUIRED] Full public URL of the deployed app — NO trailing slash
# Local dev: http://localhost:3000
# Render:    https://fixit247bm.onrender.com
NEXT_PUBLIC_APP_URL=https://fixit247bm.onrender.com
NEXT_PUBLIC_ADMIN_URL=https://fixit247-admin.onrender.com
NEXT_PUBLIC_SITE_URL=https://fixit247bm.onrender.com
NODE_ENV=production

# ── Database ─────────────────────────────────────────────────
# [REQUIRED] Pooled connection for Prisma runtime queries (pgbouncer, port 6543)
# Supabase: Dashboard → Settings → Database → Transaction pooler → URI
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-ap-southeast-2.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# [OPTIONAL] Direct connection for Prisma migrations (port 5432)
# Supabase: Dashboard → Settings → Database → Direct connection → URI
DIRECT_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres"

# ── Supabase Auth ─────────────────────────────────────────────
# [REQUIRED] Supabase: Dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://[PROJECT_REF].supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Supabase: Dashboard → Settings → API → JWT Settings → JWT Secret
SUPABASE_JWT_SECRET=your-jwt-secret

# ── Twilio (voice booking + emergency dispatch) ───────────────
# [REQUIRED] Twilio Console → Account → Account info
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-auth-token
# The phone number purchased in Twilio (E.164 format)
TWILIO_PHONE_NUMBER=+61XXXXXXXXX
# [OPTIONAL] Fallback number for human takeover
TWILIO_FALLBACK_NUMBER=+61XXXXXXXXX

# ── OpenAI ───────────────────────────────────────────────────
# [REQUIRED] platform.openai.com → API keys
OPENAI_API_KEY=sk-proj-...

# ── Stripe ───────────────────────────────────────────────────
# [OPTIONAL] Stripe dashboard → Developers → API keys
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PLATFORM_FEE_PERCENT=15

# ── Email (Resend) ────────────────────────────────────────────
# [OPTIONAL] resend.com → API keys
RESEND_API_KEY=re_...
EMAIL_FROM=noreply@fixit247.com.au

# ── Google Maps ──────────────────────────────────────────────
# [OPTIONAL] console.cloud.google.com → APIs & Services → Credentials
NEXT_PUBLIC_GOOGLE_MAPS_KEY=AIza...

# ── Upstash Redis (rate limiting, queues) ─────────────────────
# [OPTIONAL] console.upstash.com → Redis → your DB → REST API
UPSTASH_REDIS_REST_URL=https://[region].upstash.io
UPSTASH_REDIS_REST_TOKEN=your-token

# ── Sentry (error monitoring) ─────────────────────────────────
# [OPTIONAL] sentry.io → Settings → Projects → Client Keys
SENTRY_DSN=https://[key]@o[org].ingest.sentry.io/[project]
NEXT_PUBLIC_SENTRY_DSN=https://[key]@o[org].ingest.sentry.io/[project]

# ── Socket.io (realtime — leave blank to use Supabase Realtime) ─
NEXT_PUBLIC_SOCKET_URL=
SOCKET_SECRET=
