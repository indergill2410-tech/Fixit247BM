# ============================================================
# Fixit247BM — Environment Variables
# Copy to .env.local and fill in every value before running
# ============================================================

# ── App ──────────────────────────────────────────────────────
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_ADMIN_URL=http://localhost:3001
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Database (Postgres — use Supabase connection string) ─────
# Pooled connection for Prisma (transaction mode)
DATABASE_URL="postgresql://postgres:[PASSWORD]@[HOST]:6543/[DB]?pgbouncer=true&connection_limit=1"
# Direct connection for migrations
DIRECT_URL="postgresql://postgres:[PASSWORD]@[HOST]:5432/[DB]"

# ── Supabase ─────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://[PROJECT_REF].supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...
SUPABASE_JWT_SECRET=your-jwt-secret-from-supabase-dashboard

# ── Stripe ───────────────────────────────────────────────────
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PLATFORM_FEE_PERCENT=15
# STRIPE_CONNECT_CLIENT_ID=ca_...

# ── OpenAI / AI ──────────────────────────────────────────────
OPENAI_API_KEY=sk-proj-...

# ── Twilio (voice + SMS) ─────────────────────────────────────
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...
TWILIO_PHONE_NUMBER=+61...
# Optional dedicated SMS-capable AU number. Falls back to TWILIO_PHONE_NUMBER.
TWILIO_SMS_FROM_NUMBER=+61...
# Number to transfer to when AI requests human takeover
TWILIO_FALLBACK_NUMBER=+61...
# TWILIO_INBOUND_WEBHOOK=https://[domain]/api/voice/twilio/inbound

# ── Retell PropertySafe AI sales voice ───────────────────────
RETELL_API_KEY=key_...
# Australian Twilio number imported into Retell, E.164 format
RETELL_FROM_NUMBER=+61...
# Master safety switch. Keep false until telephony, migration, compliance and test calls are verified.
AI_SALES_ENABLED=false
# Long random secret used by internal sales/activation endpoints via x-fixit-sales-key
AI_SALES_INTERNAL_KEY=replace-with-at-least-32-random-characters
# Human destination for qualified/warm transfers
AI_SALES_HUMAN_TRANSFER_NUMBER=+61...
AI_SALES_DEFAULT_AGENT_ID=agent_...
AI_SALES_BOOKING_URL=https://...

# PropertySafe acquisition destinations
PROPERTYSAFE_SIGNUP_URL=https://www.fixit247.com.au/propertysafe
FIXIT247_POST_JOB_URL=https://www.fixit247.com.au/post-job

# Email sending remains OFF until fixit247.com.au is verified in the selected Resend account.
PROPERTYSAFE_EMAIL_ENABLED=false
PROPERTYSAFE_EMAIL_FROM="Fixit247 PropertySafe <hello@fixit247.com.au>"

# Retell webhook and custom tools:
# https://[domain]/api/voice/retell/webhook
# https://[domain]/api/voice/retell/tools/create-propertysafe-signup-link
# https://[domain]/api/voice/retell/tools/send-propertysafe-sms
# https://[domain]/api/voice/retell/tools/send-propertysafe-email
# https://[domain]/api/voice/retell/tools/mark-do-not-call
# https://[domain]/api/voice/retell/tools/schedule-callback
# PropertySafe app activation callback:
# https://[domain]/api/sales/propertysafe/activation

# ── Email (Resend) ────────────────────────────────────────────
RESEND_API_KEY=re_...
EMAIL_FROM=noreply@fixit247.com.au

# ── Google Maps ───────────────────────────────────────────────
NEXT_PUBLIC_GOOGLE_MAPS_KEY=AIza...

# ── Upstash Redis ─────────────────────────────────────────────
UPSTASH_REDIS_REST_URL=https://[region].upstash.io
UPSTASH_REDIS_REST_TOKEN=...

# ── Sentry ────────────────────────────────────────────────────
SENTRY_DSN=https://[key]@o[org].ingest.sentry.io/[project]
NEXT_PUBLIC_SENTRY_DSN=https://[key]@o[org].ingest.sentry.io/[project]

# ── Socket.io realtime server ─────────────────────────────────
NEXT_PUBLIC_SOCKET_URL=
SOCKET_SECRET=
