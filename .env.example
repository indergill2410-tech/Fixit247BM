# ============================================================
# Fixit247BM — Environment Variables
# Copy to .env.local and fill in every value before running
# ============================================================

# ── App ──────────────────────────────────────────────────────
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_ADMIN_URL=http://localhost:3001
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Database (Postgres — use Supabase connection string) ─────
# Pooled connection for Prisma (transaction mode)
DATABASE_URL="postgresql://postgres:[PASSWORD]@[HOST]:6543/[DB]?pgbouncer=true&connection_limit=1"
# Direct connection for migrations
DIRECT_URL="postgresql://postgres:[PASSWORD]@[HOST]:5432/[DB]"

# ── Supabase ─────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://[PROJECT_REF].supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...
SUPABASE_JWT_SECRET=your-jwt-secret-from-supabase-dashboard

# ── Stripe ───────────────────────────────────────────────────
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Platform fee charged to tradies on job completion (percent)
STRIPE_PLATFORM_FEE_PERCENT=15
# Stripe Connect (set after enabling Connect in Stripe dashboard)
# STRIPE_CONNECT_CLIENT_ID=ca_...

# ── OpenAI / AI ──────────────────────────────────────────────
OPENAI_API_KEY=sk-proj-...

# ── Twilio (voice booking + emergency dispatch) ───────────────
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...
TWILIO_PHONE_NUMBER=+61...
# Number to transfer to when AI requests human takeover
TWILIO_FALLBACK_NUMBER=+61...
# Inbound voice webhook URL (set in Twilio console → Phone Numbers → your number → Voice Configuration)
# TWILIO_INBOUND_WEBHOOK=https://[domain]/api/voice/twilio/inbound

# ── Retell AI sales voice ────────────────────────────────────
# Retell API key used for outbound calls and webhook signature verification
RETELL_API_KEY=key_...
# Australian Twilio number imported into Retell, in E.164 format
RETELL_FROM_NUMBER=+61...
# Master safety switch. Keep false until Twilio/Retell, compliance and test calls are verified.
AI_SALES_ENABLED=false
# Long random secret required by the internal outbound endpoint via x-fixit-sales-key
AI_SALES_INTERNAL_KEY=replace-with-at-least-32-random-characters
# Human destination for qualified/warm transfer calls
AI_SALES_HUMAN_TRANSFER_NUMBER=+61...
# Optional default sales agent identifier for deployment/configuration records
AI_SALES_DEFAULT_AGENT_ID=agent_...
# Public booking page sent only when a prospect asks to book or receive information
AI_SALES_BOOKING_URL=https://...
# Retell webhook: https://[domain]/api/voice/retell/webhook
# Retell DNC tool: https://[domain]/api/voice/retell/tools/mark-do-not-call
# Retell callback tool: https://[domain]/api/voice/retell/tools/schedule-callback

# ── Email (Resend) ────────────────────────────────────────────
RESEND_API_KEY=re_...
EMAIL_FROM=noreply@fixit247.com.au

# ── Google Maps (location autocomplete + distance matrix) ─────
NEXT_PUBLIC_GOOGLE_MAPS_KEY=AIza...

# ── Upstash Redis (rate limiting, job queues, session cache) ──
UPSTASH_REDIS_REST_URL=https://[region].upstash.io
UPSTASH_REDIS_REST_TOKEN=...

# ── Sentry (error monitoring) ─────────────────────────────────
SENTRY_DSN=https://[key]@o[org].ingest.sentry.io/[project]
NEXT_PUBLIC_SENTRY_DSN=https://[key]@o[org].ingest.sentry.io/[project]

# ── Socket.io realtime server (if running separately) ─────────
# Leave blank if using Supabase Realtime instead
NEXT_PUBLIC_SOCKET_URL=
SOCKET_SECRET=
