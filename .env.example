# ============================================================
# Fixit247BM — Environment Variables
# Copy to .env.local and fill in values
# ============================================================

# ----- App -----
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_ADMIN_URL=http://localhost:3001

# ----- Database -----
DATABASE_URL="postgresql://postgres:password@localhost:5432/fixit247bm"
DIRECT_URL="postgresql://postgres:password@localhost:5432/fixit247bm"

# ----- Supabase -----
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_JWT_SECRET=your-jwt-secret

# ----- Stripe Connect -----
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PLATFORM_FEE_PERCENT=15

# ----- OpenAI / AI -----
OPENAI_API_KEY=sk-...

# ----- Google Maps (location + distance) -----
NEXT_PUBLIC_GOOGLE_MAPS_KEY=AIza...

# ----- Socket.io -----
NEXT_PUBLIC_SOCKET_URL=http://localhost:4000
SOCKET_SECRET=your-socket-secret

# ----- Email (Resend) -----
RESEND_API_KEY=re_...
EMAIL_FROM=noreply@fixit247.com.au

# ----- Upstash Redis (rate limiting / queues) -----
UPSTASH_REDIS_REST_URL=https://...
UPSTASH_REDIS_REST_TOKEN=...

# ----- Sentry -----
SENTRY_DSN=https://...
NEXT_PUBLIC_SENTRY_DSN=https://...

# ----- Auth -----
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-nextauth-secret-min-32-chars
