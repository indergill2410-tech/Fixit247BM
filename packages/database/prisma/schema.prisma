// Fixit247BM — Prisma Schema
// Premium Australian emergency trade services platform

generator client {
  provider        = "prisma-client-js"
  output          = "../src/generated/client"
  previewFeatures = ["fullTextSearch", "postgresqlExtensions"]
}

datasource db {
  provider          = "postgresql"
  url               = env("DATABASE_URL")
  directUrl         = env("DIRECT_URL")
  extensions        = [postgis, uuid_ossp(map: "uuid-ossp"), pg_trgm]
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum Role {
  CUSTOMER
  TRADIE
  ADMIN
  SUPER_ADMIN
}

enum JobStatus {
  DRAFT
  OPEN
  CLAIMED
  IN_PROGRESS
  PENDING_REVIEW
  COMPLETED
  CANCELLED
  DISPUTED
}

enum JobPriority {
  STANDARD
  URGENT
  EMERGENCY
}

enum TradeCategory {
  PLUMBING
  ELECTRICAL
  HVAC
  CARPENTRY
  PAINTING
  ROOFING
  TILING
  PEST_CONTROL
  LOCKSMITH
  GLAZING
  PLASTERING
  LANDSCAPING
  CLEANING
  APPLIANCE_REPAIR
  GENERAL_MAINTENANCE
  OTHER
}

enum VerificationStatus {
  UNVERIFIED
  PENDING
  VERIFIED
  REJECTED
  SUSPENDED
}

enum PaymentStatus {
  PENDING
  PROCESSING
  HELD_IN_ESCROW
  RELEASED
  REFUNDED
  DISPUTED
  FAILED
}

enum NotificationType {
  JOB_CREATED
  JOB_ASSIGNED
  JOB_ACCEPTED
  JOB_DECLINED
  TRADIE_EN_ROUTE
  TRADIE_ARRIVED
  JOB_STARTED
  JOB_COMPLETED
  PAYMENT_HELD
  PAYMENT_RELEASED
  PAYMENT_FAILED
  DISPUTE_OPENED
  DISPUTE_RESOLVED
  NEW_MESSAGE
  CREDIT_LOW
  SUBSCRIPTION_RENEWED
  VERIFICATION_APPROVED
  VERIFICATION_REJECTED
  SYSTEM_ALERT
}

enum OnboardingStatus {
  INCOMPLETE
  PENDING_REVIEW
  APPROVED
  REJECTED
}

enum TradeBadge {
  VERIFIED
  PREMIUM
  ELITE
  EMERGENCY_SPECIALIST
  TOP_RATED
}

enum AuditAction {
  LOGIN
  LOGOUT
  REGISTER
  PASSWORD_RESET
  EMAIL_VERIFIED
  ROLE_CHANGED
  PROFILE_UPDATED
  DOCUMENT_UPLOADED
  VERIFICATION_APPROVED
  VERIFICATION_REJECTED
  PAYMENT_INITIATED
  PAYMENT_RELEASED
  JOB_CREATED
  JOB_CLAIMED
  JOB_COMPLETED
  DISPUTE_OPENED
  DISPUTE_RESOLVED
  ACCOUNT_SUSPENDED
  ACCOUNT_REINSTATED
}

enum DisputeStatus {
  OPEN
  UNDER_REVIEW
  RESOLVED
  ESCALATED
  CLOSED
}

enum SubscriptionTier {
  FREE
  BASIC
  PROFESSIONAL
  ELITE
}

enum SubscriptionStatus {
  ACTIVE
  CANCELLED
  PAUSED
  EXPIRED
}

enum TransactionType {
  PAYMENT
  PAYOUT
  REFUND
  PLATFORM_FEE
  CREDIT
  DEBIT
}

// ─── Core Models ──────────────────────────────────────────────────────────────

model User {
  id                 String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  email              String    @unique
  emailVerified      DateTime?
  phone              String?
  phoneVerified      Boolean   @default(false)
  role               Role      @default(CUSTOMER)
  firstName          String
  lastName           String
  avatarUrl          String?
  isActive           Boolean   @default(true)
  onboardingComplete Boolean   @default(false)
  lastLoginAt        DateTime?
  loginCount         Int       @default(0)
  lastIpAddress      String?
  deletedAt          DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  // Relations
  customerProfile CustomerProfile?
  tradieProfile   TradieProfile?
  sessions        Session[]
  auditLogs       AuditLog[]
  reviewsGiven    Review[]         @relation("ReviewsGiven")
  reviewsReceived Review[]         @relation("ReviewsReceived")
  addresses       Address[]
  subscription    Subscription?
  creditsWallet   CreditsWallet?

  @@index([email])
  @@index([role])
  @@index([isActive])
  @@index([deletedAt])
  @@index([createdAt])
  @@map("users")
}

model Session {
  id           String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  userId       String    @db.Uuid
  token        String    @unique
  refreshToken String?
  expiresAt    DateTime
  ipAddress    String?
  userAgent    String?
  deviceType   String?
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  lastUsedAt   DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@index([expiresAt])
  @@map("sessions")
}

model AuditLog {
  id         String      @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  userId     String?     @db.Uuid
  action     AuditAction
  resource   String?
  resourceId String?
  ipAddress  String?
  userAgent  String?
  metadata   Json?
  createdAt  DateTime    @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([action])
  @@index([resource, resourceId])
  @@index([createdAt])
  @@map("audit_logs")
}

// ─── Profile Models ───────────────────────────────────────────────────────────

model CustomerProfile {
  id                    String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  userId                String   @unique @db.Uuid
  suburb                String?
  postcode              String?
  state                 String?
  defaultAddressId      String?  @db.Uuid
  emergencyContactName  String?
  emergencyContactPhone String?
  notifyBySms           Boolean  @default(true)
  notifyByEmail         Boolean  @default(true)
  notifyByPush          Boolean  @default(true)
  creditBalance         Decimal  @default(0) @db.Decimal(10, 2)
  jobsPosted            Int      @default(0)
  totalSpent            Decimal  @default(0) @db.Decimal(12, 2)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  addresses    Address[]     @relation("CustomerAddresses")
  savedTradies SavedTradie[]
  jobs         Job[]         @relation("CustomerJobs")

  @@index([userId])
  @@map("customer_profiles")
}

model TradieProfile {
  id                   String             @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  userId               String             @unique @db.Uuid
  businessName         String?
  abn                  String?            @unique
  bio                  String?            @db.Text
  trades               TradeCategory[]
  yearsExperience      Int?
  hourlyRate           Decimal?           @db.Decimal(10, 2)
  calloutFee           Decimal?           @db.Decimal(10, 2)
  serviceRadiusKm      Int                @default(25)
  isAvailable          Boolean            @default(true)
  isEmergencyAvailable Boolean            @default(false)
  acceptsSameDay       Boolean            @default(false)
  verificationStatus   VerificationStatus @default(UNVERIFIED)
  onboardingStatus     OnboardingStatus   @default(INCOMPLETE)
  onboardingStep       Int                @default(1)
  stripeAccountId      String?            @unique
  stripeOnboardingDone Boolean            @default(false)
  avgRating            Decimal            @default(0) @db.Decimal(3, 2)
  totalReviews         Int                @default(0)
  totalJobsCompleted   Int                @default(0)
  totalEarnings        Decimal            @default(0) @db.Decimal(12, 2)
  responseTimeMinutes  Int?
  completionRate       Decimal            @default(100) @db.Decimal(5, 2)
  cancellationRate     Decimal            @default(0) @db.Decimal(5, 2)
  trustScore           Decimal            @default(0) @db.Decimal(5, 2)
  trustBadges          TradeBadge[]
  isVisible            Boolean            @default(false)
  isFeatured           Boolean            @default(false)
  rankScore            Decimal            @default(0) @db.Decimal(10, 4)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  licences          Licence[]
  insurances        Insurance[]
  certifications    Certification[]
  portfolios        TradiePortfolio[]
  availability      Availability[]
  emergencySettings EmergencySettings?
  documents         TradieDocument[]
  jobs              Job[]              @relation("TradieJobs")
  jobClaims         JobClaim[]

  @@index([verificationStatus])
  @@index([isAvailable])
  @@index([isEmergencyAvailable])
  @@index([isFeatured])
  @@index([rankScore])
  @@index([avgRating])
  @@map("tradie_profiles")
}

model TradieDocument {
  id          String             @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  tradieId    String             @db.Uuid
  type        String
  fileName    String
  fileUrl     String
  fileSize    Int?
  mimeType    String?
  status      VerificationStatus @default(PENDING)
  reviewedBy  String?
  reviewNotes String?
  expiresAt   DateTime?
  uploadedAt  DateTime           @default(now())
  verifiedAt  DateTime?

  tradie TradieProfile @relation(fields: [tradieId], references: [id], onDelete: Cascade)

  @@index([tradieId])
  @@index([status])
  @@index([type])
  @@map("tradie_documents")
}

model TradiePortfolio {
  id             String        @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  tradieId       String        @db.Uuid
  title          String
  description    String?       @db.Text
  beforeImageUrl String?
  afterImageUrl  String?
  category       TradeCategory
  completedAt    DateTime?
  createdAt      DateTime      @default(now())

  tradie TradieProfile @relation(fields: [tradieId], references: [id], onDelete: Cascade)

  @@index([tradieId])
  @@index([category])
  @@map("tradie_portfolios")
}

/// Display configuration for trade categories (separate from the TradeCategory enum)
model TradeCategoryConfig {
  id                 String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  name               String
  slug               String   @unique
  icon               String?
  description        String?  @db.Text
  emergencyAvailable Boolean  @default(true)
  displayOrder       Int      @default(0)
  isActive           Boolean  @default(true)

  @@index([slug])
  @@index([isActive])
  @@index([displayOrder])
  @@map("trade_category_configs")
}

model Availability {
  id          String  @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  tradieId    String  @db.Uuid
  dayOfWeek   Int     // 0 = Sunday … 6 = Saturday
  startTime   String  // "HH:MM" 24-hour
  endTime     String  // "HH:MM" 24-hour
  isAvailable Boolean @default(true)

  tradie TradieProfile @relation(fields: [tradieId], references: [id], onDelete: Cascade)

  @@unique([tradieId, dayOfWeek])
  @@index([tradieId])
  @@map("availability")
}

model EmergencySettings {
  id                  String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  tradieId            String   @unique @db.Uuid
  isAvailable         Boolean  @default(false)
  maxRadius           Int      @default(25)
  responseTimeMinutes Int      @default(30)
  surchargePercent    Decimal  @default(50) @db.Decimal(5, 2)
  autoAccept          Boolean  @default(false)
  updatedAt           DateTime @updatedAt

  tradie TradieProfile @relation(fields: [tradieId], references: [id], onDelete: Cascade)

  @@map("emergency_settings")
}

// ─── Location & Address ───────────────────────────────────────────────────────

model Address {
  id               String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  userId           String    @db.Uuid
  customerProfileId String?  @db.Uuid
  label            String?
  street           String
  suburb           String
  city             String
  state            String
  postcode         String
  country          String    @default("AU")
  latitude         Decimal?  @db.Decimal(10, 7)
  longitude        Decimal?  @db.Decimal(10, 7)
  isDefault        Boolean   @default(false)
  deletedAt        DateTime?
  createdAt        DateTime  @default(now())

  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  customerProfile CustomerProfile? @relation("CustomerAddresses", fields: [customerProfileId], references: [id])
  jobs            Job[]

  @@index([userId])
  @@index([customerProfileId])
  @@index([deletedAt])
  @@map("addresses")
}

model SavedTradie {
  id         String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  customerId String   @db.Uuid
  tradieId   String   @db.Uuid
  createdAt  DateTime @default(now())

  customer CustomerProfile @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([customerId, tradieId])
  @@index([customerId])
  @@index([tradieId])
  @@map("saved_tradies")
}

// ─── Jobs ─────────────────────────────────────────────────────────────────────

model Job {
  id                 String        @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  customerId         String        @db.Uuid
  tradieId           String?       @db.Uuid
  addressId          String?       @db.Uuid
  title              String
  description        String        @db.Text
  category           TradeCategory
  status             JobStatus     @default(OPEN)
  priority           JobPriority   @default(STANDARD)
  isEmergency        Boolean       @default(false)
  scheduledFor       DateTime?
  estimatedHours     Decimal?      @db.Decimal(5, 2)
  agreedPrice        Decimal?      @db.Decimal(10, 2)
  finalPrice         Decimal?      @db.Decimal(10, 2)
  platformFee        Decimal?      @db.Decimal(10, 2)
  tradieEarnings     Decimal?      @db.Decimal(10, 2)
  aiMatchScore       Decimal?      @db.Decimal(5, 4)
  aiSuggestedTradies String[]      @db.Uuid
  claimedAt          DateTime?
  startedAt          DateTime?
  completedAt        DateTime?
  cancelledAt        DateTime?
  cancelReason       String?
  disputeId          String?       @db.Uuid
  budgetMin          Decimal?      @db.Decimal(10, 2)
  budgetMax          Decimal?      @db.Decimal(10, 2)
  complexity         JobComplexity @default(MEDIUM)
  mediaUrls          String[]
  voiceNoteUrl       String?
  preferredTime      String?
  leadPrice          Decimal?      @db.Decimal(8, 2)
  matchingBatchNo    Int           @default(0)
  aiProcessedAt      DateTime?
  offerExpiresAt     DateTime?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  customer      CustomerProfile  @relation("CustomerJobs", fields: [customerId], references: [id])
  tradie        TradieProfile?   @relation("TradieJobs", fields: [tradieId], references: [id])
  address       Address?         @relation(fields: [addressId], references: [id])
  claims        JobClaim[]
  messages      Message[]
  images        JobImage[]
  timeline      JobStatusHistory[]
  payment       Payment?
  review        Review?
  dispute       Dispute?
  matchingQueue JobMatchingQueue[]
  events        JobEvent[]
  aiInsight     AIJobInsight?

  @@index([customerId])
  @@index([tradieId])
  @@index([status])
  @@index([category])
  @@index([priority])
  @@index([isEmergency])
  @@index([scheduledFor])
  @@index([createdAt])
  @@map("jobs")
}

model JobClaim {
  id             String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  jobId          String    @db.Uuid
  tradieId       String    @db.Uuid
  message        String?   @db.Text
  quotedPrice    Decimal   @db.Decimal(10, 2)
  estimatedHours Decimal?  @db.Decimal(5, 2)
  isAccepted     Boolean   @default(false)
  acceptedAt     DateTime?
  expiresAt      DateTime?
  createdAt      DateTime  @default(now())

  job    Job           @relation(fields: [jobId], references: [id], onDelete: Cascade)
  tradie TradieProfile @relation(fields: [tradieId], references: [id])

  @@index([jobId])
  @@index([tradieId])
  @@index([isAccepted])
  @@map("job_claims")
}

model JobStatusHistory {
  id         String     @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  jobId      String     @db.Uuid
  fromStatus JobStatus?
  toStatus   JobStatus
  note       String?
  changedBy  String     @db.Uuid
  createdAt  DateTime   @default(now())

  job Job @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId])
  @@index([createdAt])
  @@map("job_status_history")
}

model JobImage {
  id         String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  jobId      String   @db.Uuid
  url        String
  type       String   // 'BEFORE' | 'AFTER' | 'PROGRESS' | 'ISSUE'
  uploadedBy String   @db.Uuid
  createdAt  DateTime @default(now())

  job Job @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId])
  @@index([type])
  @@map("job_images")
}

// ─── Reviews ──────────────────────────────────────────────────────────────────

model Review {
  id           String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  jobId        String    @unique @db.Uuid
  reviewerId   String    @db.Uuid
  revieweeId   String    @db.Uuid
  rating       Int       // 1–5
  title        String?
  body         String?   @db.Text
  isPublic     Boolean   @default(true)
  responseText String?   @db.Text
  respondedAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  job      Job  @relation(fields: [jobId], references: [id])
  reviewer User @relation("ReviewsGiven", fields: [reviewerId], references: [id])
  reviewee User @relation("ReviewsReceived", fields: [revieweeId], references: [id])

  @@index([revieweeId])
  @@index([reviewerId])
  @@index([rating])
  @@index([isPublic])
  @@map("reviews")
}

// ─── Messaging ────────────────────────────────────────────────────────────────

model Message {
  id          String        @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  jobId       String        @db.Uuid
  senderId    String        @db.Uuid
  receiverId  String?       @db.Uuid
  content     String        @db.Text
  type        MessageType   @default(TEXT)
  status      MessageStatus @default(SENT)
  mediaUrl    String?
  mediaType   String?
  isSystem    Boolean       @default(false)
  deletedAt   DateTime?
  deliveredAt DateTime?
  readAt      DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([jobId])
  @@index([senderId])
  @@index([receiverId])
  @@index([createdAt])
  @@map("messages")
}

// ─── Notifications ────────────────────────────────────────────────────────────

model Notification {
  id         String           @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  userId     String           @db.Uuid
  jobId      String?          @db.Uuid
  type       NotificationType
  title      String
  body       String           @db.Text
  data       Json?
  status     NotifStatus      @default(PENDING)
  channel    NotifChannel     @default(IN_APP)
  readAt     DateTime?
  sentAt     DateTime?
  failedAt   DateTime?
  retryCount Int              @default(0)
  createdAt  DateTime         @default(now())

  @@index([userId])
  @@index([status])
  @@index([type])
  @@index([jobId])
  @@index([createdAt])
  @@map("notifications")
}

// ─── Payments ─────────────────────────────────────────────────────────────────

model Payment {
  id                    String        @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  jobId                 String        @unique @db.Uuid
  customerId            String        @db.Uuid
  tradieId              String        @db.Uuid
  amount                Decimal       @db.Decimal(10, 2)
  platformFee           Decimal       @db.Decimal(10, 2)
  tradieAmount          Decimal       @db.Decimal(10, 2)
  currency              String        @default("AUD")
  status                PaymentStatus @default(PENDING)
  stripePaymentIntentId String?       @unique
  stripeTransferId      String?
  stripeCustomerId      String?
  paidAt                DateTime?
  releasedAt            DateTime?
  refundedAt            DateTime?
  refundAmount          Decimal?      @db.Decimal(10, 2)
  refundReason          String?
  disputeId             String?       @db.Uuid
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  job Job @relation(fields: [jobId], references: [id])

  @@index([customerId])
  @@index([tradieId])
  @@index([status])
  @@index([createdAt])
  @@map("payments")
}

// ─── Disputes ─────────────────────────────────────────────────────────────────

model Dispute {
  id           String        @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  jobId        String        @unique @db.Uuid
  raisedBy     String        @db.Uuid
  respondentId String        @db.Uuid
  reason       String
  description  String        @db.Text
  status       DisputeStatus @default(OPEN)
  resolution   String?       @db.Text
  resolvedBy   String?       @db.Uuid
  resolvedAt   DateTime?
  refundAmount Decimal?      @db.Decimal(10, 2)
  evidence     Json?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  job Job @relation(fields: [jobId], references: [id])

  @@index([raisedBy])
  @@index([respondentId])
  @@index([status])
  @@index([createdAt])
  @@map("disputes")
}

// ─── Subscriptions ────────────────────────────────────────────────────────────

model Subscription {
  id                   String             @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  userId               String             @unique @db.Uuid
  tier                 SubscriptionTier   @default(FREE)
  status               SubscriptionStatus @default(ACTIVE)
  stripeSubscriptionId String?
  stripePriceId        String?
  currentPeriodStart   DateTime?
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean            @default(false)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@index([tier])
  @@map("subscriptions")
}

// ─── Credits & Wallet ─────────────────────────────────────────────────────────

model CreditsWallet {
  id             String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  userId         String   @unique @db.Uuid
  balance        Decimal  @default(0) @db.Decimal(10, 2)
  lifetimeEarned Decimal  @default(0) @db.Decimal(12, 2)
  lifetimeSpent  Decimal  @default(0) @db.Decimal(12, 2)
  updatedAt      DateTime @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@map("credits_wallets")
}

model Transaction {
  id            String          @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  walletId      String          @db.Uuid
  type          TransactionType
  amount        Decimal         @db.Decimal(10, 2)
  balanceAfter  Decimal         @db.Decimal(10, 2)
  description   String?
  referenceId   String?
  referenceType String?
  metadata      Json?
  createdAt     DateTime        @default(now())

  wallet CreditsWallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@index([walletId])
  @@index([type])
  @@index([createdAt])
  @@map("transactions")
}

// ─── Tradie Credentials ───────────────────────────────────────────────────────

model Licence {
  id            String             @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  tradieId      String             @db.Uuid
  licenceType   String
  licenceNumber String
  state         String
  expiresAt     DateTime?
  documentUrl   String?
  status        VerificationStatus @default(PENDING)
  verifiedAt    DateTime?
  createdAt     DateTime           @default(now())

  tradie TradieProfile @relation(fields: [tradieId], references: [id], onDelete: Cascade)

  @@index([tradieId])
  @@index([status])
  @@map("licences")
}

model Insurance {
  id           String             @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  tradieId     String             @db.Uuid
  insurer      String
  policyNumber String
  coverType    String
  coverAmount  Decimal            @db.Decimal(12, 2)
  expiresAt    DateTime
  documentUrl  String?
  status       VerificationStatus @default(PENDING)
  verifiedAt   DateTime?
  createdAt    DateTime           @default(now())

  tradie TradieProfile @relation(fields: [tradieId], references: [id], onDelete: Cascade)

  @@index([tradieId])
  @@index([status])
  @@map("insurances")
}

model Certification {
  id          String             @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  tradieId    String             @db.Uuid
  name        String
  issuedBy    String
  issuedAt    DateTime
  expiresAt   DateTime?
  documentUrl String?
  status      VerificationStatus @default(PENDING)
  createdAt   DateTime           @default(now())

  tradie TradieProfile @relation(fields: [tradieId], references: [id], onDelete: Cascade)

  @@index([tradieId])
  @@index([status])
  @@map("certifications")
}

// ─── New Enums ────────────────────────────────────────────────────────────────

enum MatchStatus {
  PENDING
  SENT
  ACCEPTED
  DECLINED
  EXPIRED
  FALLBACK
}

enum JobEventType {
  CREATED
  AI_PROCESSED
  MATCHING_STARTED
  OFFER_SENT
  OFFER_ACCEPTED
  OFFER_DECLINED
  OFFER_EXPIRED
  REASSIGNED
  TRADIE_EN_ROUTE
  TRADIE_ARRIVED
  WORK_STARTED
  WORK_COMPLETED
  PAYMENT_REQUESTED
  PAYMENT_RECEIVED
  DISPUTED
  CANCELLED
}

enum OnlineStatus {
  ONLINE
  OFFLINE
  BUSY
  EMERGENCY_ONLY
  AWAY
}

enum JobComplexity {
  SIMPLE
  MEDIUM
  COMPLEX
}

// ─── New Models ───────────────────────────────────────────────────────────────

model JobMatchingQueue {
  id            String      @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  jobId         String      @db.Uuid
  tradieId      String      @db.Uuid
  batchNumber   Int         @default(1)
  matchScore    Decimal     @db.Decimal(8, 4)
  distanceKm    Decimal?    @db.Decimal(8, 2)
  status        MatchStatus @default(PENDING)
  sentAt        DateTime?
  respondedAt   DateTime?
  expiresAt     DateTime?
  declineReason String?
  createdAt     DateTime    @default(now())

  @@index([jobId])
  @@index([tradieId])
  @@index([status])
  @@index([batchNumber])
  @@index([expiresAt])
  @@map("job_matching_queue")
}

model JobEvent {
  id        String       @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  jobId     String       @db.Uuid
  type      JobEventType
  actorId   String?      @db.Uuid
  actorRole Role?
  metadata  Json?
  createdAt DateTime     @default(now())

  @@index([jobId])
  @@index([type])
  @@index([createdAt])
  @@map("job_events")
}

model TradieRealtimeStatus {
  id               String       @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  tradieId         String       @unique @db.Uuid
  onlineStatus     OnlineStatus @default(OFFLINE)
  lastHeartbeatAt  DateTime?
  currentJobId     String?      @db.Uuid
  activeJobCount   Int          @default(0)
  travelRadiusKm   Int          @default(25)
  currentLatitude  Decimal?     @db.Decimal(10, 7)
  currentLongitude Decimal?     @db.Decimal(10, 7)
  isAutoAccept     Boolean      @default(false)
  updatedAt        DateTime     @updatedAt

  @@index([onlineStatus])
  @@index([lastHeartbeatAt])
  @@map("tradie_realtime_status")
}

model AIJobInsight {
  id                  String        @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  jobId               String        @unique @db.Uuid
  rawInput            String        @db.Text
  extractedCategory   TradeCategory
  complexity          JobComplexity @default(MEDIUM)
  urgencyScore        Int
  confidenceScore     Int
  isEmergencyDetected Boolean       @default(false)
  emergencyIndicators String[]
  suggestedTitle      String
  professionalSummary String        @db.Text
  suggestedMaterials  String[]
  estimatedPriceMin   Decimal?      @db.Decimal(10, 2)
  estimatedPriceMax   Decimal?      @db.Decimal(10, 2)
  leadPrice           Decimal?      @db.Decimal(8, 2)
  suggestedTrades     String[]
  imageAnalysis       Json?
  voiceTranscript     String?       @db.Text
  modelUsed           String?
  processingMs        Int?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  @@index([jobId])
  @@index([extractedCategory])
  @@index([urgencyScore])
  @@map("ai_job_insights")
}

// ─── Financial Extension ──────────────────────────────────────────────────────

enum PayoutStatus {
  PENDING
  PROCESSING
  PAID
  FAILED
  HELD
  CANCELLED
}

enum SurgeFactor {
  NONE
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum CreditTransactionType {
  PURCHASE
  JOB_DEDUCTION
  BONUS
  REFUND
  ADMIN_ADJUSTMENT
  REFERRAL
  SUBSCRIPTION_CREDIT
}

model Payout {
  id                String       @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  tradieId          String       @db.Uuid
  jobId             String?      @db.Uuid
  amount            Decimal      @db.Decimal(10, 2)
  currency          String       @default("AUD")
  status            PayoutStatus @default(PENDING)
  stripeTransferId  String?      @unique
  stripePayoutId    String?
  scheduledFor      DateTime?
  processedAt       DateTime?
  failureReason     String?
  isHeld            Boolean      @default(false)
  heldReason        String?
  heldBy            String?      @db.Uuid
  metadata          Json?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  @@index([tradieId])
  @@index([status])
  @@index([jobId])
  @@index([createdAt])
  @@map("payouts")
}

model CreditPackage {
  id            String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  name          String
  credits       Int
  priceAud      Decimal  @db.Decimal(8, 2)
  bonusCredits  Int      @default(0)
  stripePriceId String?
  isActive      Boolean  @default(true)
  isPopular     Boolean  @default(false)
  displayOrder  Int      @default(0)
  createdAt     DateTime @default(now())

  @@index([isActive])
  @@index([displayOrder])
  @@map("credit_packages")
}

model CreditLedger {
  id           String                @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  tradieId     String                @db.Uuid
  type         CreditTransactionType
  credits      Int
  balanceAfter Int
  jobId        String?               @db.Uuid
  packageId    String?               @db.Uuid
  referenceId  String?
  description  String
  metadata     Json?
  createdAt    DateTime              @default(now())

  @@index([tradieId])
  @@index([type])
  @@index([jobId])
  @@index([createdAt])
  @@map("credit_ledger")
}

model PlatformConfig {
  id        String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  key       String   @unique
  value     String
  category  String   @default("general")
  updatedBy String?  @db.Uuid
  updatedAt DateTime @updatedAt

  @@index([category])
  @@map("platform_config")
}

model SurgePricingRule {
  id              String      @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  name            String
  factor          SurgeFactor
  multiplier      Decimal     @db.Decimal(4, 2)
  startHour       Int?        // 0-23, null = always
  endHour         Int?        // 0-23, null = always
  daysOfWeek      Int[]       // 0=Sun … 6=Sat, empty = all days
  tradeCategories String[]    // empty = all trades
  isActive        Boolean     @default(true)
  priority        Int         @default(0)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@index([isActive])
  @@index([factor])
  @@map("surge_pricing_rules")
}

