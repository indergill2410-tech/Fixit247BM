// Fixit247BM — Prisma Schema
// Premium Australian emergency trade services platform

generator client {
  provider        = "prisma-client-js"
  output          = "../src/generated/client"
  previewFeatures = ["fullTextSearch", "postgresqlExtensions"]
}

datasource db {
  provider          = "postgresql"
  url               = env("DATABASE_URL")
  directUrl         = env("DIRECT_URL")
  extensions        = [postgis, uuid_ossp(map: "uuid-ossp"), pg_trgm]
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum Role {
  CUSTOMER
  TRADIE
  ADMIN
  SUPER_ADMIN
}

enum JobStatus {
  DRAFT
  OPEN
  CLAIMED
  IN_PROGRESS
  PENDING_REVIEW
  COMPLETED
  CANCELLED
  DISPUTED
}

enum JobPriority {
  STANDARD
  URGENT
  EMERGENCY
}

enum TradeCategory {
  PLUMBING
  ELECTRICAL
  HVAC
  CARPENTRY
  PAINTING
  ROOFING
  TILING
  PEST_CONTROL
  LOCKSMITH
  GLAZING
  PLASTERING
  LANDSCAPING
  CLEANING
  APPLIANCE_REPAIR
  GENERAL_MAINTENANCE
  OTHER
}

enum VerificationStatus {
  UNVERIFIED
  PENDING
  VERIFIED
  REJECTED
  SUSPENDED
}

enum PaymentStatus {
  PENDING
  PROCESSING
  HELD_IN_ESCROW
  RELEASED
  REFUNDED
  DISPUTED
  FAILED
}

enum NotificationType {
  JOB_CREATED
  JOB_ASSIGNED
  JOB_STARTED
  JOB_COMPLETED
  JOB_CANCELLED
  MESSAGE_RECEIVED
  QUOTE_RECEIVED
  QUOTE_ACCEPTED
  PAYMENT_RECEIVED
  REVIEW_RECEIVED
  DOCUMENT_VERIFIED
  SYSTEM_ALERT
}

enum OnboardingStatus {
  INCOMPLETE
  PENDING_REVIEW
  APPROVED
  REJECTED
}

enum TradeBadge {
  VERIFIED
  PREMIUM
  ELITE
  EMERGENCY_SPECIALIST
  TOP_RATED
}

enum AuditAction {
  LOGIN
  LOGOUT
  REGISTER
  PASSWORD_RESET
  EMAIL_VERIFIED
  ROLE_CHANGED
  PROFILE_UPDATED
  DOCUMENT_UPLOADED
  VERIFICATION_APPROVED
  VERIFICATION_REJECTED
  PAYMENT_INITIATED
  PAYMENT_RELEASED
  JOB_CREATED
  JOB_CLAIMED
  JOB_COMPLETED
  DISPUTE_OPENED
  DISPUTE_RESOLVED
  ACCOUNT_SUSPENDED
  ACCOUNT_REINSTATED
}

enum DisputeStatus {
  OPEN
  UNDER_REVIEW
  RESOLVED
  ESCALATED
  CLOSED
}

enum SubscriptionTier {
  FREE
  BASIC
  PROFESSIONAL
  ELITE
}

enum SubscriptionStatus {
  ACTIVE
  CANCELLED
  PAUSED
  EXPIRED
}

enum TransactionType {
  PAYMENT
  PAYOUT
  REFUND
  PLATFORM_FEE
  CREDIT
  DEBIT
}

// ─── Core Models ──────────────────────────────────────────────────────────────

model User {
  id                 String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  email              String    @unique
  emailVerified      DateTime?
  phone              String?
  phoneVerified      Boolean   @default(false)
  role               Role      @default(CUSTOMER)
  firstName          String
  lastName           String
  avatarUrl          String?
  isActive           Boolean   @default(true)
  onboardingComplete Boolean   @default(false)
  lastLoginAt        DateTime?
  loginCount         Int       @default(0)
  lastIpAddress      String?
  deletedAt          DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  // Relations
  customerProfile       CustomerProfile?
  tradieProfile         TradieProfile?
  sessions              Session[]
  auditLogs             AuditLog[]
  notifications         Notification[]
  sentMessages          Message[]        @relation("MessageSender")
  receivedNotifications Notification[]   @relation("NotificationRecipient")
  reviewsGiven          Review[]         @relation("ReviewsGiven")
  reviewsReceived       Review[]         @relation("ReviewsReceived")
  addresses             Address[]
  subscription          Subscription?
  creditsWallet         CreditsWallet?

  @@index([email])
  @@index([role])
  @@index([isActive])
  @@index([deletedAt])
  @@index([createdAt])
  @@map("users")
}

model Session {
  id           String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  userId       String    @db.Uuid
  token        String    @unique
  refreshToken String?
  expiresAt    DateTime
  ipAddress    String?
  userAgent    String?
  deviceType   String?
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  lastUsedAt   DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@index([expiresAt])
  @@map("sessions")
}

model AuditLog {
  id         String      @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  userId     String?     @db.Uuid
  action     AuditAction
  resource   String?
  resourceId String?
  ipAddress  String?
  userAgent  String?
  metadata   Json?
  createdAt  DateTime    @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([action])
  @@index([resource, resourceId])
  @@index([createdAt])
  @@map("audit_logs")
}

// ─── Profile Models ───────────────────────────────────────────────────────────

model CustomerProfile {
  id                    String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  userId                String   @unique @db.Uuid
  suburb                String?
  postcode              String?
  state                 String?
  defaultAddressId      String?  @db.Uuid
  emergencyContactName  String?
  emergencyContactPhone String?
  notifyBySms           Boolean  @default(true)
  notifyByEmail         Boolean  @default(true)
  notifyByPush          Boolean  @default(true)
  creditBalance         Decimal  @default(0) @db.Decimal(10, 2)
  jobsPosted            Int      @default(0)
  totalSpent            Decimal  @default(0) @db.Decimal(12, 2)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  addresses    Address[]     @relation("CustomerAddresses")
  savedTradies SavedTradie[]
  jobs         Job[]         @relation("CustomerJobs")

  @@index([userId])
  @@map("customer_profiles")
}

model TradieProfile {
  id                   String             @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  userId               String             @unique @db.Uuid
  businessName         String?
  abn                  String?            @unique
  bio                  String?            @db.Text
  trades               TradeCategory[]
  yearsExperience      Int?
  hourlyRate           Decimal?           @db.Decimal(10, 2)
  calloutFee           Decimal?           @db.Decimal(10, 2)
  serviceRadiusKm      Int                @default(25)
  isAvailable          Boolean            @default(true)
  isEmergencyAvailable Boolean            @default(false)
  acceptsSameDay       Boolean            @default(false)
  verificationStatus   VerificationStatus @default(UNVERIFIED)
  onboardingStatus     OnboardingStatus   @default(INCOMPLETE)
  onboardingStep       Int                @default(1)
  stripeAccountId      String?            @unique
  stripeOnboardingDone Boolean            @default(false)
  avgRating            Decimal            @default(0) @db.Decimal(3, 2)
  totalReviews         Int                @default(0)
  totalJobsCompleted   Int                @default(0)
  totalEarnings        Decimal            @default(0) @db.Decimal(12, 2)
  responseTimeMinutes  Int?
  completionRate       Decimal            @default(100) @db.Decimal(5, 2)
  cancellationRate     Decimal            @default(0) @db.Decimal(5, 2)
  trustScore           Decimal            @default(0) @db.Decimal(5, 2)
  trustBadges          TradeBadge[]
  isVisible            Boolean            @default(false)
  isFeatured           Boolean            @default(false)
  rankScore            Decimal            @default(0) @db.Decimal(10, 4)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  licences          Licence[]
  insurances        Insurance[]
  certifications    Certification[]
  portfolios        TradiePortfolio[]
  availability      Availability[]
  emergencySettings EmergencySettings?
  documents         TradieDocument[]
  jobs              Job[]              @relation("TradieJobs")
  jobClaims         JobClaim[]

  @@index([verificationStatus])
  @@index([isAvailable])
  @@index([isEmergencyAvailable])
  @@index([isFeatured])
  @@index([rankScore])
  @@index([avgRating])
  @@map("tradie_profiles")
}

model TradieDocument {
  id          String             @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  tradieId    String             @db.Uuid
  type        String
  fileName    String
  fileUrl     String
  fileSize    Int?
  mimeType    String?
  status      VerificationStatus @default(PENDING)
  reviewedBy  String?
  reviewNotes String?
  expiresAt   DateTime?
  uploadedAt  DateTime           @default(now())
  verifiedAt  DateTime?

  tradie TradieProfile @relation(fields: [tradieId], references: [id], onDelete: Cascade)

  @@index([tradieId])
  @@index([status])
  @@index([type])
  @@map("tradie_documents")
}

model TradiePortfolio {
  id             String        @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  tradieId       String        @db.Uuid
  title          String
  description    String?       @db.Text
  beforeImageUrl String?
  afterImageUrl  String?
  category       TradeCategory
  completedAt    DateTime?
  createdAt      DateTime      @default(now())

  tradie TradieProfile @relation(fields: [tradieId], references: [id], onDelete: Cascade)

  @@index([tradieId])
  @@index([category])
  @@map("tradie_portfolios")
}

/// Display configuration for trade categories (separate from the TradeCategory enum)
model TradeCategoryConfig {
  id                 String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  name               String
  slug               String   @unique
  icon               String?
  description        String?  @db.Text
  emergencyAvailable Boolean  @default(true)
  displayOrder       Int      @default(0)
  isActive           Boolean  @default(true)

  @@index([slug])
  @@index([isActive])
  @@index([displayOrder])
  @@map("trade_category_configs")
}

model Availability {
  id          String  @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  tradieId    String  @db.Uuid
  dayOfWeek   Int     // 0 = Sunday … 6 = Saturday
  startTime   String  // "HH:MM" 24-hour
  endTime     String  // "HH:MM" 24-hour
  isAvailable Boolean @default(true)

  tradie TradieProfile @relation(fields: [tradieId], references: [id], onDelete: Cascade)

  @@unique([tradieId, dayOfWeek])
  @@index([tradieId])
  @@map("availability")
}

model EmergencySettings {
  id                  String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  tradieId            String   @unique @db.Uuid
  isAvailable         Boolean  @default(false)
  maxRadius           Int      @default(25)
  responseTimeMinutes Int      @default(30)
  surchargePercent    Decimal  @default(50) @db.Decimal(5, 2)
  autoAccept          Boolean  @default(false)
  updatedAt           DateTime @updatedAt

  tradie TradieProfile @relation(fields: [tradieId], references: [id], onDelete: Cascade)

  @@map("emergency_settings")
}

// ─── Location & Address ───────────────────────────────────────────────────────

model Address {
  id               String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  userId           String    @db.Uuid
  customerProfileId String?  @db.Uuid
  label            String?
  street           String
  suburb           String
  city             String
  state            String
  postcode         String
  country          String    @default("AU")
  latitude         Decimal?  @db.Decimal(10, 7)
  longitude        Decimal?  @db.Decimal(10, 7)
  isDefault        Boolean   @default(false)
  deletedAt        DateTime?
  createdAt        DateTime  @default(now())

  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  customerProfile CustomerProfile? @relation("CustomerAddresses", fields: [customerProfileId], references: [id])
  jobs            Job[]

  @@index([userId])
  @@index([customerProfileId])
  @@index([deletedAt])
  @@map("addresses")
}

model SavedTradie {
  id         String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  customerId String   @db.Uuid
  tradieId   String   @db.Uuid
  createdAt  DateTime @default(now())

  customer CustomerProfile @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([customerId, tradieId])
  @@index([customerId])
  @@index([tradieId])
  @@map("saved_tradies")
}

// ─── Jobs ─────────────────────────────────────────────────────────────────────

model Job {
  id                 String        @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  customerId         String        @db.Uuid
  tradieId           String?       @db.Uuid
  addressId          String?       @db.Uuid
  title              String
  description        String        @db.Text
  category           TradeCategory
  status             JobStatus     @default(OPEN)
  priority           JobPriority   @default(STANDARD)
  isEmergency        Boolean       @default(false)
  scheduledFor       DateTime?
  estimatedHours     Decimal?      @db.Decimal(5, 2)
  agreedPrice        Decimal?      @db.Decimal(10, 2)
  finalPrice         Decimal?      @db.Decimal(10, 2)
  platformFee        Decimal?      @db.Decimal(10, 2)
  tradieEarnings     Decimal?      @db.Decimal(10, 2)
  aiMatchScore       Decimal?      @db.Decimal(5, 4)
  aiSuggestedTradies String[]      @db.Uuid
  claimedAt          DateTime?
  startedAt          DateTime?
  completedAt        DateTime?
  cancelledAt        DateTime?
  cancelReason       String?
  disputeId          String?       @db.Uuid
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  customer CustomerProfile  @relation("CustomerJobs", fields: [customerId], references: [id])
  tradie   TradieProfile?   @relation("TradieJobs", fields: [tradieId], references: [id])
  address  Address?         @relation(fields: [addressId], references: [id])
  claims   JobClaim[]
  messages Message[]
  images   JobImage[]
  timeline JobStatusHistory[]
  payment  Payment?
  review   Review?
  dispute  Dispute?

  @@index([customerId])
  @@index([tradieId])
  @@index([status])
  @@index([category])
  @@index([priority])
  @@index([isEmergency])
  @@index([scheduledFor])
  @@index([createdAt])
  @@map("jobs")
}

model JobClaim {
  id             String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  jobId          String    @db.Uuid
  tradieId       String    @db.Uuid
  message        String?   @db.Text
  quotedPrice    Decimal   @db.Decimal(10, 2)
  estimatedHours Decimal?  @db.Decimal(5, 2)
  isAccepted     Boolean   @default(false)
  acceptedAt     DateTime?
  expiresAt      DateTime?
  createdAt      DateTime  @default(now())

  job    Job           @relation(fields: [jobId], references: [id], onDelete: Cascade)
  tradie TradieProfile @relation(fields: [tradieId], references: [id])

  @@index([jobId])
  @@index([tradieId])
  @@index([isAccepted])
  @@map("job_claims")
}

model JobStatusHistory {
  id         String     @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  jobId      String     @db.Uuid
  fromStatus JobStatus?
  toStatus   JobStatus
  note       String?
  changedBy  String     @db.Uuid
  createdAt  DateTime   @default(now())

  job Job @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId])
  @@index([createdAt])
  @@map("job_status_history")
}

model JobImage {
  id         String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  jobId      String   @db.Uuid
  url        String
  type       String   // 'BEFORE' | 'AFTER' | 'PROGRESS' | 'ISSUE'
  uploadedBy String   @db.Uuid
  createdAt  DateTime @default(now())

  job Job @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId])
  @@index([type])
  @@map("job_images")
}

// ─── Reviews ──────────────────────────────────────────────────────────────────

model Review {
  id           String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  jobId        String    @unique @db.Uuid
  reviewerId   String    @db.Uuid
  revieweeId   String    @db.Uuid
  rating       Int       // 1–5
  title        String?
  body         String?   @db.Text
  isPublic     Boolean   @default(true)
  responseText String?   @db.Text
  respondedAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  job      Job  @relation(fields: [jobId], references: [id])
  reviewer User @relation("ReviewsGiven", fields: [reviewerId], references: [id])
  reviewee User @relation("ReviewsReceived", fields: [revieweeId], references: [id])

  @@index([revieweeId])
  @@index([reviewerId])
  @@index([rating])
  @@index([isPublic])
  @@map("reviews")
}

// ─── Messaging ────────────────────────────────────────────────────────────────

model Message {
  id          String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  jobId       String    @db.Uuid
  senderId    String    @db.Uuid
  receiverId  String    @db.Uuid
  body        String    @db.Text
  attachments String[]
  readAt      DateTime?
  isSystem    Boolean   @default(false)
  createdAt   DateTime  @default(now())

  job    Job  @relation(fields: [jobId], references: [id], onDelete: Cascade)
  sender User @relation("MessageSender", fields: [senderId], references: [id])

  @@index([jobId])
  @@index([senderId])
  @@index([receiverId])
  @@index([readAt])
  @@map("messages")
}

// ─── Notifications ────────────────────────────────────────────────────────────

model Notification {
  id        String           @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  userId    String           @db.Uuid
  type      NotificationType
  title     String
  body      String
  data      Json?
  readAt    DateTime?
  actionUrl String?
  createdAt DateTime         @default(now())

  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)
  recipient User @relation("NotificationRecipient", fields: [userId], references: [id])

  @@index([userId])
  @@index([readAt])
  @@index([createdAt])
  @@map("notifications")
}

// ─── Payments ─────────────────────────────────────────────────────────────────

model Payment {
  id                    String        @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  jobId                 String        @unique @db.Uuid
  customerId            String        @db.Uuid
  tradieId              String        @db.Uuid
  amount                Decimal       @db.Decimal(10, 2)
  platformFee           Decimal       @db.Decimal(10, 2)
  tradieAmount          Decimal       @db.Decimal(10, 2)
  currency              String        @default("AUD")
  status                PaymentStatus @default(PENDING)
  stripePaymentIntentId String?       @unique
  stripeTransferId      String?
  stripeCustomerId      String?
  paidAt                DateTime?
  releasedAt            DateTime?
  refundedAt            DateTime?
  refundAmount          Decimal?      @db.Decimal(10, 2)
  refundReason          String?
  disputeId             String?       @db.Uuid
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  job Job @relation(fields: [jobId], references: [id])

  @@index([customerId])
  @@index([tradieId])
  @@index([status])
  @@index([createdAt])
  @@map("payments")
}

// ─── Disputes ─────────────────────────────────────────────────────────────────

model Dispute {
  id           String        @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  jobId        String        @unique @db.Uuid
  raisedBy     String        @db.Uuid
  respondentId String        @db.Uuid
  reason       String
  description  String        @db.Text
  status       DisputeStatus @default(OPEN)
  resolution   String?       @db.Text
  resolvedBy   String?       @db.Uuid
  resolvedAt   DateTime?
  refundAmount Decimal?      @db.Decimal(10, 2)
  evidence     Json?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  job Job @relation(fields: [jobId], references: [id])

  @@index([raisedBy])
  @@index([respondentId])
  @@index([status])
  @@index([createdAt])
  @@map("disputes")
}

// ─── Subscriptions ────────────────────────────────────────────────────────────

model Subscription {
  id                   String             @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  userId               String             @unique @db.Uuid
  tier                 SubscriptionTier   @default(FREE)
  status               SubscriptionStatus @default(ACTIVE)
  stripeSubscriptionId String?
  stripePriceId        String?
  currentPeriodStart   DateTime?
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean            @default(false)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@index([tier])
  @@map("subscriptions")
}

// ─── Credits & Wallet ─────────────────────────────────────────────────────────

model CreditsWallet {
  id             String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  userId         String   @unique @db.Uuid
  balance        Decimal  @default(0) @db.Decimal(10, 2)
  lifetimeEarned Decimal  @default(0) @db.Decimal(12, 2)
  lifetimeSpent  Decimal  @default(0) @db.Decimal(12, 2)
  updatedAt      DateTime @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@map("credits_wallets")
}

model Transaction {
  id            String          @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  walletId      String          @db.Uuid
  type          TransactionType
  amount        Decimal         @db.Decimal(10, 2)
  balanceAfter  Decimal         @db.Decimal(10, 2)
  description   String?
  referenceId   String?
  referenceType String?
  metadata      Json?
  createdAt     DateTime        @default(now())

  wallet CreditsWallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@index([walletId])
  @@index([type])
  @@index([createdAt])
  @@map("transactions")
}

// ─── Tradie Credentials ───────────────────────────────────────────────────────

model Licence {
  id            String             @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  tradieId      String             @db.Uuid
  licenceType   String
  licenceNumber String
  state         String
  expiresAt     DateTime?
  documentUrl   String?
  status        VerificationStatus @default(PENDING)
  verifiedAt    DateTime?
  createdAt     DateTime           @default(now())

  tradie TradieProfile @relation(fields: [tradieId], references: [id], onDelete: Cascade)

  @@index([tradieId])
  @@index([status])
  @@map("licences")
}

model Insurance {
  id           String             @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  tradieId     String             @db.Uuid
  insurer      String
  policyNumber String
  coverType    String
  coverAmount  Decimal            @db.Decimal(12, 2)
  expiresAt    DateTime
  documentUrl  String?
  status       VerificationStatus @default(PENDING)
  verifiedAt   DateTime?
  createdAt    DateTime           @default(now())

  tradie TradieProfile @relation(fields: [tradieId], references: [id], onDelete: Cascade)

  @@index([tradieId])
  @@index([status])
  @@map("insurances")
}

model Certification {
  id          String             @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  tradieId    String             @db.Uuid
  name        String
  issuedBy    String
  issuedAt    DateTime
  expiresAt   DateTime?
  documentUrl String?
  status      VerificationStatus @default(PENDING)
  createdAt   DateTime           @default(now())

  tradie TradieProfile @relation(fields: [tradieId], references: [id], onDelete: Cascade)

  @@index([tradieId])
  @@index([status])
  @@map("certifications")
}
